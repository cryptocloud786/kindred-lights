extends Node2D
## Kindred Lights - a small light in a long night.
## Made for thatgamejam #02. All visuals are drawn in code and all sound in
## res://audio is generated by tools/gen_audio.py, except the jam theme track
## by Jason Grace (used unmodified, ending only).

const AUD := "res://audio/"
const PENTA := [0, 3, 5, 7, 10, 12, 15, 17, 19, 22]
const BEAT := 0.75  # 80 bpm, the tempo of the theme track
const WISP_HUES := [0.08, 0.55, 0.88, 0.14, 0.47, 0.97, 0.62, 0.03, 0.75, 0.33, 0.11, 0.52, 0.92, 0.18, 0.67, 0.42]

enum { TITLE, PLAY, ENDING, CREDITS }
var mode := TITLE

# nodes
var glow_tex: Texture2D
var solid: Node2D
var fx: Node2D
var fog: Node2D
var cam: Camera2D
var sky_mat: ShaderMaterial
var hint_label: Label
var title_box: VBoxContainer
var title_press: Label
var fade: ColorRect
var pause_box: VBoxContainer
var credits_box: VBoxContainer
var credits_again: Label

# player
var p_pos := Vector2(0, 300)
var p_vel := Vector2.ZERO
var warmth := 1.0
var humming := false
var hum_ring := 0.0
var hum_vol := 0.0
var trail: Array = []
var safe_pos := Vector2(0, 300)
var rescue_t := 0.0
var cold_amt := 0.0
var in_mist := 0.0

# world
var wisps: Array = []
var chain: Array = []
var beacons: Array = []
var mists: Array = []
var currents: Array = []
var motes: Array = []
var bursts: Array = []
var sparkles: Array = []
var world_warm := 0.0
var warm_target := 0.0
var lit_count := 0
var t := 0.0
var ending_t := 0.0
var credits_t := 0.0
var started_theme := false

# hints
var shown: Dictionary = {}
var hint_queue: Array = []
var hint_t := 0.0
var hint_dur := 0.0

# audio
var layers: Array = []
var layer_target: Array = [0.55, 0.0, 0.0, 0.0]
var hum_player: AudioStreamPlayer
var wind_player: AudioStreamPlayer
var theme_player: AudioStreamPlayer
var sfx_pool: Array = []
var chime_stream: AudioStream
var beacon_stream: AudioStream
var scatter_stream: AudioStream

# screenshot automation (desktop only, passed after `--`)
var shot_dir := ""
var shot_plan: Array = []
var force_hum := false
var shot_skip := false
var autoplay := false
var bot_log_t := 0.0


func _ready() -> void:
	randomize()
	seed(20261107)
	_setup_input()
	_make_glow()
	_make_sky()
	solid = Node2D.new(); add_child(solid); solid.draw.connect(_draw_solid)
	fx = Node2D.new(); add_child(fx)
	var add_mat := CanvasItemMaterial.new(); add_mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	fx.material = add_mat; fx.draw.connect(_draw_fx)
	fog = Node2D.new(); add_child(fog); fog.draw.connect(_draw_fog)
	cam = Camera2D.new(); add_child(cam); cam.position = p_pos + Vector2(0, -60); cam.make_current()
	_build_level()
	for i in 220:
		motes.append({"p": Vector2(randf_range(-800, 800), randf_range(-500, 500)) + p_pos, "s": randf_range(0.5, 1.6), "ph": randf() * TAU})
	_setup_audio()
	_setup_ui()
	_parse_args()


# ---------------------------------------------------------------- setup
func _setup_input() -> void:
	var keys := {
		"left": [KEY_A, KEY_LEFT], "right": [KEY_D, KEY_RIGHT],
		"up": [KEY_W, KEY_UP], "down": [KEY_S, KEY_DOWN],
		"hum": [KEY_SPACE, KEY_J, KEY_Z, KEY_SHIFT],
	}
	for a in keys:
		if InputMap.has_action(a):
			continue
		InputMap.add_action(a, 0.25)
		for k in keys[a]:
			var e := InputEventKey.new(); e.physical_keycode = k
			InputMap.action_add_event(a, e)
	var axes := {"left": [JOY_AXIS_LEFT_X, -1.0], "right": [JOY_AXIS_LEFT_X, 1.0], "up": [JOY_AXIS_LEFT_Y, -1.0], "down": [JOY_AXIS_LEFT_Y, 1.0]}
	for a in axes:
		var j := InputEventJoypadMotion.new(); j.axis = axes[a][0]; j.axis_value = axes[a][1]
		InputMap.action_add_event(a, j)
	var jb := InputEventJoypadButton.new(); jb.button_index = JOY_BUTTON_A
	InputMap.action_add_event("hum", jb)
	var mb := InputEventMouseButton.new(); mb.button_index = MOUSE_BUTTON_RIGHT
	InputMap.action_add_event("hum", mb)


func _make_glow() -> void:
	var g := Gradient.new()
	g.offsets = PackedFloat32Array([0.0, 0.1, 0.3, 0.6, 1.0])
	g.colors = PackedColorArray([Color(1, 1, 1, 1), Color(1, 1, 1, 0.72), Color(1, 1, 1, 0.3), Color(1, 1, 1, 0.08), Color(1, 1, 1, 0)])
	var gt := GradientTexture2D.new()
	gt.gradient = g; gt.width = 128; gt.height = 128
	gt.fill = GradientTexture2D.FILL_RADIAL
	gt.fill_from = Vector2(0.5, 0.5); gt.fill_to = Vector2(1.0, 0.5)
	glow_tex = gt


func _make_sky() -> void:
	var layer := CanvasLayer.new(); layer.layer = -10; add_child(layer)
	var rect := ColorRect.new(); rect.set_anchors_preset(Control.PRESET_FULL_RECT)
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	sky_mat = ShaderMaterial.new(); sky_mat.shader = load("res://sky.gdshader")
	rect.material = sky_mat; layer.add_child(rect)


func _wisp(pos: Vector2, shy := false) -> void:
	var hue: float = WISP_HUES[wisps.size() % WISP_HUES.size()]
	wisps.append({"home": pos, "pos": pos, "vel": Vector2.ZERO, "state": 0, "shy": shy, "listen": 0.0,
		"seed": randf() * 100.0, "col": Color.from_hsv(hue, 0.42, 1.0), "flee": 0.0, "fdir": Vector2.ZERO,
		"ymin": pos.y - 260.0, "ymax": pos.y + 260.0, "hello": 0.0, "fcd": 0.0})


func _beacon(pos: Vector2, need: int) -> void:
	beacons.append({"pos": pos, "need": need, "lit": false, "charge": 0.0, "glow": 0.0})


func _mist(c: Vector2, r: float, s: float, gate := -1) -> void:
	mists.append({"c": c, "r": r, "s": s, "gate": gate, "alpha": 1.0, "seed": randf() * 50.0})


func _wall(y: float, gate: int) -> void:
	var x := -1500.0
	while x <= 1500.0:
		_mist(Vector2(x, y + randf_range(-50, 50)), randf_range(220, 270), 7.0, gate)
		x += 105.0


func _build_level() -> void:
	# I. alone
	_wisp(Vector2(-380, 20)); _wisp(Vector2(430, -260)); _wisp(Vector2(-180, -640))
	_beacon(Vector2(0, -900), 2)
	_wall(-1200, 0)
	# II. the cold
	_wisp(Vector2(-720, -1500)); _wisp(Vector2(680, -1640)); _wisp(Vector2(-280, -1990))
	_wisp(Vector2(930, -2230)); _wisp(Vector2(-960, -2330))
	_mist(Vector2(930, -2230), 270, 0.75); _mist(Vector2(-600, -1820), 210, 0.6)
	_mist(Vector2(320, -1880), 230, 0.6); _mist(Vector2(-960, -2330), 240, 0.75)
	_beacon(Vector2(0, -2470), 5)
	_wall(-2780, 1)
	# III. wind and the shy ones
	_wisp(Vector2(-820, -3010), true); _wisp(Vector2(720, -3430), true)
	_wisp(Vector2(-520, -3560)); _wisp(Vector2(960, -3910), true)
	currents.append({"rect": Rect2(-1500, -3270, 3000, 140), "force": Vector2(640, 0)})
	currents.append({"rect": Rect2(-1500, -3790, 3000, 140), "force": Vector2(-640, 0)})
	_mist(Vector2(-820, -3010), 170, 0.5)
	_beacon(Vector2(0, -4080), 9)
	_wall(-4360, 2)
	# IV. the deep cold, crossable only together
	_wisp(Vector2(-640, -4720)); _wisp(Vector2(620, -4930)); _wisp(Vector2(-900, -5300)); _wisp(Vector2(330, -5470))
	_mist(Vector2(620, -4930), 300, 1.7); _mist(Vector2(0, -5120), 300, 1.7)
	_mist(Vector2(-900, -5300), 270, 1.7); _mist(Vector2(400, -5480), 240, 1.7)
	_mist(Vector2(-450, -4980), 220, 1.4)
	_beacon(Vector2(0, -5760), 14)


func _setup_audio() -> void:
	for i in 4:
		var s: AudioStream = load(AUD + "layer%d.ogg" % i)
		s.loop = true
		var pl := AudioStreamPlayer.new(); pl.stream = s; pl.volume_db = -60.0
		add_child(pl); layers.append(pl)
	for pl in layers:
		pl.play()
	var hs: AudioStreamWAV = load(AUD + "hum.wav")
	hs.loop_mode = AudioStreamWAV.LOOP_FORWARD; hs.loop_begin = 0; hs.loop_end = 88200
	hum_player = AudioStreamPlayer.new(); hum_player.stream = hs; hum_player.volume_db = -60.0
	add_child(hum_player); hum_player.play()
	var ws: AudioStream = load(AUD + "wind.ogg"); ws.loop = true
	wind_player = AudioStreamPlayer.new(); wind_player.stream = ws; wind_player.volume_db = -60.0
	add_child(wind_player); wind_player.play()
	theme_player = AudioStreamPlayer.new(); theme_player.stream = load(AUD + "theme_jason_grace.ogg")
	add_child(theme_player)
	chime_stream = load(AUD + "chime.wav")
	beacon_stream = load(AUD + "beacon.wav")
	scatter_stream = load(AUD + "scatter.wav")
	for i in 8:
		var p := AudioStreamPlayer.new(); add_child(p); sfx_pool.append(p)


func _sfx(stream: AudioStream, pitch := 1.0, vol := 0.0) -> void:
	for p in sfx_pool:
		if not p.playing:
			p.stream = stream; p.pitch_scale = pitch; p.volume_db = vol; p.play(); return
	var q: AudioStreamPlayer = sfx_pool[0]
	q.stream = stream; q.pitch_scale = pitch; q.volume_db = vol; q.play()


func _label(text: String, size: int, col := Color(1, 0.96, 0.9)) -> Label:
	var l := Label.new(); l.text = text
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", col)
	l.add_theme_color_override("font_outline_color", Color(0.02, 0.02, 0.08, 0.85))
	l.add_theme_constant_override("outline_size", max(4, size / 8))
	return l


