# ---------------------------------------------------------------- input
func _unhandled_input(event: InputEvent) -> void:
	var pressed: bool = (event is InputEventKey and event.pressed and not event.echo) \
		or (event is InputEventMouseButton and event.pressed) \
		or (event is InputEventJoypadButton and event.pressed)
	if not pressed:
		return
	if event is InputEventKey and event.physical_keycode == KEY_F:
		var fs := DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED if fs else DisplayServer.WINDOW_MODE_FULLSCREEN)
		return
	if get_tree().paused:
		if event is InputEventKey and event.physical_keycode == KEY_Q and not OS.has_feature("web"):
			get_tree().quit()
		elif event is InputEventKey and event.physical_keycode in [KEY_ESCAPE, KEY_P]:
			_set_paused(false)
		elif event is InputEventJoypadButton and event.button_index == JOY_BUTTON_START:
			_set_paused(false)
		return
	match mode:
		TITLE:
			_start_play()
		PLAY, ENDING:
			if (event is InputEventKey and event.physical_keycode in [KEY_ESCAPE, KEY_P]) \
				or (event is InputEventJoypadButton and event.button_index == JOY_BUTTON_START):
				_set_paused(true)
		CREDITS:
			if credits_t > 4.0:
				get_tree().reload_current_scene()


func _set_paused(on: bool) -> void:
	get_tree().paused = on
	pause_box.visible = on


func _start_play() -> void:
	mode = PLAY
	var tw := create_tween(); tw.tween_property(title_box, "modulate:a", 0.0, 1.2)
	tw.tween_callback(func(): title_box.visible = false)
	_hint("move", "Drift with the mouse (hold click), WASD or a gamepad.")


func _move_input() -> Vector2:
	var v := Input.get_vector("left", "right", "up", "down")
	if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		var to := get_global_mouse_position() - p_pos
		v = to.normalized() * clamp(to.length() / 160.0, 0.0, 1.0)
	return v


func _hint(key: String, text: String) -> void:
	if shown.has(key):
		return
	shown[key] = true
	hint_queue.append(text)


# ---------------------------------------------------------------- loop
func _process(delta: float) -> void:
	delta = min(delta, 0.05)
	t += delta
	match mode:
		TITLE:
			p_pos = Vector2(0, 300) + Vector2(sin(t * 0.8) * 10, sin(t * 1.3) * 8)
			title_press.modulate.a = 0.55 + 0.45 * sin(t * TAU / (BEAT * 2))
		PLAY:
			_update_player(delta)
			_update_beacons(delta)
		ENDING:
			_update_player(delta)
			_update_ending(delta)
		CREDITS:
			credits_t += delta
			credits_again.modulate.a = clamp(credits_t - 4.0, 0.0, 1.0) * (0.6 + 0.4 * sin(t * 3.0))
	_update_wisps(delta)
	_update_world(delta)
	_update_audio(delta)
	_update_hints(delta)
	var look := p_pos + p_vel * 0.25 + Vector2(0, -40)
	cam.position = cam.position.lerp(look, 1.0 - exp(-2.8 * delta))
	sky_mat.set_shader_parameter("cam", cam.position)
	sky_mat.set_shader_parameter("warm", world_warm)
	sky_mat.set_shader_parameter("cold", cold_amt)
	sky_mat.set_shader_parameter("tm", t)
	sky_mat.set_shader_parameter("res", get_viewport_rect().size)
	solid.queue_redraw(); fx.queue_redraw(); fog.queue_redraw()
	_shots(delta)


func _mist_at(pos: Vector2) -> float:
	var s := 0.0
	for m in mists:
		if m.alpha < 0.02:
			continue
		var d: float = pos.distance_to(m.c)
		if d < m.r:
			var k: float = 1.0 - d / m.r
			s = max(s, m.s * m.alpha * min(1.0, k * 2.2))
	return s


func _update_player(delta: float) -> void:
	humming = Input.is_action_pressed("hum") or force_hum
	var inp := _move_input()
	if autoplay:
		inp = _bot()
	var maxs := 105.0 if humming else 330.0
	var desired := inp * maxs
	if mode == ENDING:
		desired += Vector2(0, -95.0 * clamp(ending_t / 4.0, 0.0, 1.0))
	if rescue_t > 0.0:
		rescue_t -= delta
		p_pos = p_pos.lerp(safe_pos, 1.0 - exp(-3.0 * delta))
		p_vel = Vector2.ZERO
		desired = Vector2.ZERO
	p_vel = p_vel.lerp(desired, 1.0 - exp(-3.2 * delta))
	for c in currents:
		if c.rect.has_point(p_pos):
			p_vel += c.force * delta * (0.35 if humming else 1.0)
			_hint("wind", "Ride the wind. Hum to hold steady.")
	# soft world bounds
	if abs(p_pos.x) > 1250.0:
		p_vel.x -= sign(p_pos.x) * 700.0 * delta
	if p_pos.y > 600.0:
		p_vel.y -= 700.0 * delta
	if mode == PLAY and p_pos.y < -5950.0:
		p_vel.y += 700.0 * delta
	# cold
	var s := _mist_at(p_pos)
	in_mist = s
	var walled := false
	for m in mists:
		if m.gate >= 0 and m.alpha > 0.3 and p_pos.distance_to(m.c) < m.r * 0.85:
			walled = true
	if walled:
		p_vel.y += 900.0 * delta
		_hint("wall", "Too cold to cross... the old lantern below might help.")
	var drain: float = max(0.0, s - 0.11 * chain.size())
	if s > 0.05 and not walled:
		if chain.size() > 0 and drain < s:
			_hint("mist2", "The cold drains your light. Friends keep you warm.")
		else:
			_hint("mist", "The cold drains your light. Don't linger alone.")
	if drain > 0.0:
		warmth -= drain * 0.6 * delta
	else:
		warmth = min(1.0, warmth + 0.4 * delta)
		if s < 0.02 and rescue_t <= 0.0:
			safe_pos = p_pos
	if warmth <= 0.0 and mode == PLAY:
		_scatter()
	cold_amt = lerp(cold_amt, clamp(s * 0.6 + (1.0 - warmth) * 0.8, 0.0, 1.0), 1.0 - exp(-3.0 * delta))
	p_pos += p_vel * delta
	trail.push_front(p_pos)
	if trail.size() > 26:
		trail.pop_back()
	# hum ring
	if humming:
		hum_ring = min(200.0, hum_ring + 280.0 * delta)
	else:
		hum_ring = max(0.0, hum_ring - 420.0 * delta)


func _scatter() -> void:
	_sfx(scatter_stream, 1.0, -4.0)
	bursts.append({"pos": p_pos, "t": 0.0, "col": Color(0.6, 0.75, 1.0), "size": 260.0})
	for w in chain:
		w.state = 0
		w.listen = 0.0
	chain.clear()
	warmth = 0.6
	rescue_t = 1.4
	_hint("scatter", "Your light wavered and your friends drifted home. Gather them again.")


func _join(w: Dictionary) -> void:
	w.state = 1
	w.hello = 1.0
	chain.append(w)
	var n := chain.size()
	var semis: int = PENTA[(n - 1) % PENTA.size()] - 7
	_sfx(chime_stream, pow(2.0, semis / 12.0), -3.0)
	bursts.append({"pos": w.pos, "t": 0.0, "col": w.col, "size": 150.0})
	if n == 1:
		_hint("joined", "They remember warmth. Gather the lost lights.")
	elif n == 2 and lit_count == 0:
		_hint("tolantern", "Hum beside the old lantern, up ahead.")


func _update_wisps(delta: float) -> void:
	var spd := p_vel.length()
	for w in wisps:
		w.hello = max(0.0, w.hello - delta)
		match w.state:
			0:
				var d: float = w.pos.distance_to(p_pos)
				if mode == PLAY and d < 340.0 and not shown.has("hum"):
					_hint("hum", "Hold SPACE (or right-click) to hum to it.")
				if w.shy and mode == PLAY:
					if d < 330.0:
						_hint("shy", "This one is shy. Come close slowly, humming.")
					w.fcd = max(0.0, w.fcd - delta)
					if d < 240.0 and spd > 150.0 and w.flee <= 0.0 and w.fcd <= 0.0:
						w.flee = 1.0
						w.fcd = 2.2
						w.fdir = (w.pos - p_pos).normalized()
						w.listen = 0.0
				var target: Vector2 = w.home + Vector2(sin(t * 0.7 + w.seed) * 20.0, cos(t * 0.9 + w.seed) * 14.0)
				if w.flee > 0.0:
					w.flee -= delta
					w.home.x += sign(w.fdir.x) * 120.0 * delta
					w.home.x = clamp(w.home.x, -1150.0, 1150.0)
					w.home.y = clamp(w.home.y, w.ymin, w.ymax)
					target = w.home + w.fdir * 60.0
				w.vel = w.vel.lerp((target - w.pos) * 2.2, 1.0 - exp(-3.0 * delta))
				w.pos += w.vel * delta
				var hears: bool = humming and d < hum_ring + 24.0 and (not w.shy or spd < 150.0)
				if hears and mode == PLAY:
					w.listen += delta / (1.1 if w.shy else 0.6)
				else:
					w.listen = max(0.0, w.listen - delta * 0.7)
				if w.listen >= 1.0:
					_join(w)
			1:
				var idx := chain.find(w)
				var lead: Vector2 = p_pos if idx <= 0 else chain[idx - 1].pos
				var gap := 30.0 if idx <= 0 else 23.0
				var to: Vector2 = lead - w.pos
				var wob := Vector2(sin(t * 2.1 + w.seed), cos(t * 1.7 + w.seed)) * 6.0
				var target: Vector2 = lead - to.normalized() * gap + wob
				if to.length() < gap:
					target = w.pos + wob * 0.2
				w.vel = w.vel.lerp((target - w.pos) * 7.0, 1.0 - exp(-9.0 * delta))
				w.pos += w.vel * delta
			2:
				# ending: spread into a slow rising constellation around the player
				var ang: float = w.seed * 2.4 + t * 0.12
				var rad: float = 150.0 + fmod(w.seed * 37.0, 160.0)
				var target2: Vector2 = p_pos + Vector2(cos(ang), sin(ang) * 0.6) * rad
				w.vel = w.vel.lerp((target2 - w.pos) * 1.5, 1.0 - exp(-2.0 * delta))
				w.pos += w.vel * delta


func _update_beacons(delta: float) -> void:
	for i in beacons.size():
		var b: Dictionary = beacons[i]
		if b.lit:
			continue
		var d: float = p_pos.distance_to(b.pos)
		if d < 520.0:
			if chain.size() < b.need:
				_hint("need%d" % i, "This lantern needs %d friends beside you." % b.need)
			else:
				_hint("ready%d" % i, "Hum beside the lantern.")
		if d < 220.0 and humming and chain.size() >= b.need:
			b.charge += delta / 1.6
			if b.charge >= 1.0:
				_light(i)
		else:
			b.charge = max(0.0, b.charge - delta)


func _light(i: int) -> void:
	var b: Dictionary = beacons[i]
	b.lit = true
	lit_count += 1
	warm_target = 0.22 * lit_count
	_sfx(beacon_stream, 1.0, 0.0)
	bursts.append({"pos": b.pos + Vector2(0, -80), "t": 0.0, "col": Color(1.0, 0.75, 0.45), "size": 700.0})
	for w in chain:
		w.hello = 1.2
	if lit_count < 4:
		layer_target[lit_count] = 0.5 if lit_count < 3 else 0.45
		_hint("lit%d" % i, ["The cold lifts. Go higher.", "Warmth spreads. Higher still.", "One lantern left, high above."][lit_count - 1])
	else:
		_start_ending()


func _start_ending() -> void:
	mode = ENDING
	ending_t = 0.0
	for k in 4:
		layer_target[k] = 0.0
	_hint("rise", "Rise, together.")


func _update_ending(delta: float) -> void:
	ending_t += delta
	if ending_t > 1.5 and not started_theme:
		started_theme = true
		theme_player.play()
	warm_target = clamp(0.9 + ending_t / 50.0 * 0.6, 0.9, 1.5)
	cam.zoom = cam.zoom.lerp(Vector2(0.8, 0.8), 1.0 - exp(-0.3 * delta))
	if randf() < delta * 6.0:
		sparkles.append({"pos": cam.position + Vector2(randf_range(-760, 760), randf_range(-480, 200)), "t": 0.0,
			"col": Color.from_hsv(randf(), 0.3, 1.0)})
	if ending_t > 44.0:
		for w in chain:
			w.state = 2
	if ending_t > 55.0 and mode == ENDING:
		mode = CREDITS
		credits_t = 0.0
		var tw := create_tween()
		tw.tween_property(fade, "color:a", 0.85, 3.0)
		tw.tween_callback(func(): credits_box.visible = true; credits_box.modulate.a = 0.0)
		tw.tween_property(credits_box, "modulate:a", 1.0, 2.0)


func _update_world(delta: float) -> void:
	world_warm = lerp(world_warm, warm_target, 1.0 - exp(-0.6 * delta))
	for m in mists:
		if m.gate >= 0 and beacons[m.gate].lit:
			m.alpha = move_toward(m.alpha, 0.0, delta * 0.35)
	for b in beacons:
		if b.lit:
			b.glow = min(1.0, b.glow + delta * 0.6)
	for bu in bursts:
		bu.t += delta
	bursts = bursts.filter(func(x): return x.t < 2.2)
	for s in sparkles:
		s.t += delta
	sparkles = sparkles.filter(func(x): return x.t < 4.0)
	var c := cam.position
	for m in motes:
		m.p += Vector2(sin(t * 0.3 + m.ph) * 6.0, -9.0 * m.s) * delta
		m.p.x = c.x + fposmod(m.p.x - c.x + 820.0, 1640.0) - 820.0
		m.p.y = c.y + fposmod(m.p.y - c.y + 520.0, 1040.0) - 520.0


func _vol(pl: AudioStreamPlayer, target_lin: float, rate: float, delta: float) -> void:
	var cur := db_to_linear(pl.volume_db)
	cur = move_toward(cur, target_lin, rate * delta)
	pl.volume_db = linear_to_db(max(cur, 0.0001))


func _update_audio(delta: float) -> void:
	for i in 4:
		_vol(layers[i], layer_target[i], 0.12, delta)
	hum_vol = 0.32 if humming and mode != TITLE else 0.0
	_vol(hum_player, hum_vol, 1.5, delta)
	_vol(wind_player, clamp(in_mist * 0.5, 0.0, 0.55) + 0.05, 0.6, delta)


func _update_hints(delta: float) -> void:
	if hint_dur <= 0.0:
		if hint_queue.size() > 0:
			hint_label.text = hint_queue.pop_front()
			hint_dur = 4.8
			hint_t = 0.0
		else:
			hint_label.modulate.a = 0.0
			return
	hint_t += delta
	hint_label.modulate.a = clamp(min(hint_t / 0.6, (hint_dur - hint_t) / 0.8), 0.0, 1.0)
	if hint_t >= hint_dur:
		hint_dur = 0.0


# ---------------------------------------------------------------- drawing
func _glow(node: CanvasItem, pos: Vector2, size: float, col: Color) -> void:
	node.draw_texture_rect(glow_tex, Rect2(pos - Vector2(size, size) * 0.5, Vector2(size, size)), false, col)


func _on_screen(pos: Vector2, margin: float) -> bool:
	var half := get_viewport_rect().size * 0.5 / cam.zoom
	return abs(pos.x - cam.position.x) < half.x + margin and abs(pos.y - cam.position.y) < half.y + margin


func _draw_solid() -> void:
	for i in beacons.size():
		var b: Dictionary = beacons[i]
		if not _on_screen(b.pos, 300.0):
			continue
		var p: Vector2 = b.pos
		var stone := Color(0.07, 0.08, 0.14).lerp(Color(0.22, 0.15, 0.17), b.glow)
		var edge := Color(0.16, 0.18, 0.28).lerp(Color(0.85, 0.55, 0.35), b.glow)
		var body := PackedVector2Array([p + Vector2(-34, 60), p + Vector2(-22, -40), p + Vector2(-40, -52), p + Vector2(-30, -64),
			p + Vector2(30, -64), p + Vector2(40, -52), p + Vector2(22, -40), p + Vector2(34, 60)])
		solid.draw_colored_polygon(body, stone)
		body.append(body[0])
		solid.draw_polyline(body, edge, 2.0, true)
		solid.draw_rect(Rect2(p + Vector2(-60, 58), Vector2(120, 14)), stone)
		solid.draw_line(p + Vector2(-60, 58), p + Vector2(60, 58), edge, 2.0, true)
		# carved rings
		for k in 3:
			var y := 30.0 - k * 26.0
			solid.draw_arc(p + Vector2(0, y), 9.0, 0, TAU, 20, edge * Color(1, 1, 1, 0.5), 1.5, true)
		# need dots
		if not b.lit and p_pos.distance_to(p) < 700.0:
			var n: int = b.need
			for k in n:
				var a: float = PI + PI * (k + 0.5) / n
				var dp: Vector2 = p + Vector2(0, -70) + Vector2(cos(a), sin(a)) * 120.0
				if k < chain.size():
					solid.draw_circle(dp, 6.0, Color(1.0, 0.82, 0.55, 0.95))
				else:
					solid.draw_arc(dp, 6.0, 0, TAU, 16, Color(0.7, 0.75, 0.95, 0.55), 1.5, true)


func _draw_fx() -> void:
	var beat := 0.5 + 0.5 * cos(t * TAU / BEAT)
	for m in motes:
		var a: float = 0.08 + 0.1 * (0.5 + 0.5 * sin(t * 1.3 + m.ph))
		_glow(fx, m.p, 7.0 * m.s, Color(0.75, 0.82, 1.0, a))
	for c in currents:
		var r: Rect2 = c.rect
		if not _on_screen(r.get_center(), 1600.0):
			continue
		var dir: float = sign(c.force.x)
		for k in 46:
			var hy := fmod(k * 0.618, 1.0)
			var len := 60.0 + 70.0 * fmod(k * 0.37, 1.0)
			var x: float = r.position.x + fposmod(k * 211.0 + dir * t * (260.0 + 90.0 * hy), r.size.x)
			var y: float = r.position.y + 10.0 + hy * (r.size.y - 20.0) + sin(t + k) * 4.0
			var a2 := 0.10 + 0.08 * sin(t * 2.0 + k)
			fx.draw_line(Vector2(x, y), Vector2(x - dir * len, y), Color(0.55, 0.7, 1.0, a2), 2.0, true)
	for b in beacons:
		if not _on_screen(b.pos, 600.0):
			continue
		var fp: Vector2 = b.pos + Vector2(0, -78)
		if b.glow > 0.0:
			var fl := 0.9 + 0.1 * sin(t * 9.0) * sin(t * 5.3)
			_glow(fx, fp, 900.0 * b.glow, Color(1.0, 0.6, 0.35, 0.22 * b.glow))
			_glow(fx, fp, 240.0 * b.glow * fl, Color(1.0, 0.78, 0.5, 0.6 * b.glow))
			_glow(fx, fp, 60.0 * fl, Color(1.0, 0.95, 0.85, 0.9 * b.glow))
		else:
			_glow(fx, fp, 30.0 + 8.0 * beat, Color(1.0, 0.5, 0.3, 0.25))
			if b.charge > 0.0:
				_glow(fx, fp, 80.0 + 300.0 * b.charge, Color(1.0, 0.75, 0.45, 0.5 * b.charge))
	for w in wisps:
		if not _on_screen(w.pos, 120.0):
			continue
		var col: Color = w.col
		if w.state == 0:
			var a3: float = 0.35 + 0.2 * beat + 0.4 * w.listen
			var sz: float = 96.0 + 18.0 * beat + 50.0 * w.listen
			if w.shy:
				a3 *= 0.75
			_glow(fx, w.pos, sz, Color(col.r, col.g, col.b, a3 * 0.7))
			_glow(fx, w.pos, 20.0 + 8.0 * w.listen, Color(1, 1, 1, 0.6 + 0.4 * w.listen))
			if w.listen > 0.0:
				fx.draw_arc(w.pos, 30.0, -PI / 2, -PI / 2 + TAU * w.listen, 32, Color(col.r, col.g, col.b, 0.6), 2.0, true)
		else:
			var hum_boost := 0.25 if humming else 0.0
			_glow(fx, w.pos, 110.0 + 60.0 * w.hello + 14.0 * beat, Color(col.r, col.g, col.b, 0.5 + hum_boost + 0.3 * w.hello))
			_glow(fx, w.pos, 24.0, Color(1, 1, 1, 0.95))
	# player
	var wcol := Color(1.0, 0.78, 0.5)
	for i in range(trail.size() - 1, 0, -2):
		var k := 1.0 - float(i) / trail.size()
		_glow(fx, trail[i], 60.0 * k * warmth + 8.0, Color(wcol.r, wcol.g, wcol.b, 0.22 * k * warmth))
	if in_mist > 0.05 and chain.size() > 0:
		_glow(fx, p_pos, 160.0 + chain.size() * 18.0, Color(1.0, 0.7, 0.45, 0.10))
	var flick := 1.0
	if warmth < 0.35:
		flick = 0.6 + 0.4 * abs(sin(t * 23.0))
	_glow(fx, p_pos, (170.0 + 150.0 * warmth + 16.0 * beat) * flick, Color(wcol.r, wcol.g, wcol.b, (0.25 + 0.35 * warmth) * flick))
	_glow(fx, p_pos, 48.0 * (0.6 + 0.4 * warmth), Color(1.0, 0.95, 0.85, 1.0))
	if hum_ring > 1.0:
		var ra := 0.35 * (1.0 - hum_ring / 260.0)
		fx.draw_arc(p_pos, hum_ring, 0, TAU, 64, Color(1.0, 0.85, 0.6, ra), 2.5, true)
		var r2 := fmod(t / BEAT, 1.0) * hum_ring
		fx.draw_arc(p_pos, r2, 0, TAU, 48, Color(1.0, 0.85, 0.6, ra * (1.0 - r2 / max(hum_ring, 1.0))), 1.5, true)
	for bu in bursts:
		var k2: float = bu.t / 2.2
		var c2: Color = bu.col
		_glow(fx, bu.pos, bu.size * (0.4 + k2), Color(c2.r, c2.g, c2.b, 0.6 * (1.0 - k2)))
		fx.draw_arc(bu.pos, bu.size * 0.5 * k2 + 10.0, 0, TAU, 48, Color(c2.r, c2.g, c2.b, 0.5 * (1.0 - k2)), 2.0, true)
	for s in sparkles:
		var k3: float = s.t / 4.0
		var c3: Color = s.col
		_glow(fx, s.pos, 26.0, Color(c3.r, c3.g, c3.b, sin(k3 * PI) * 0.8))


func _draw_fog() -> void:
	var frost := Color(0.62, 0.74, 0.94)
	for m in mists:
		if m.alpha < 0.01 or not _on_screen(m.c, m.r + 200.0):
			continue
		var a: float = m.alpha * clamp(0.12 + m.s * 0.06, 0.12, 0.2)
		for k in 3:
			var off: Vector2 = Vector2(sin(t * 0.21 + m.seed + k * 2.1), cos(t * 0.17 + m.seed + k * 1.3)) * m.r * 0.22
			var sz: float = m.r * (2.3 + 0.25 * k)
			_glow(fog, m.c + off, sz, Color(frost.r, frost.g, frost.b, a))
		if m.gate < 0:
			for k in 5:
				var gp: Vector2 = m.c + Vector2(cos(m.seed + k * 1.7 + t * 0.1), sin(m.seed * 1.3 + k * 2.3)) * m.r * 0.6
				fog.draw_circle(gp, 1.6, Color(0.9, 0.95, 1.0, 0.5 * m.alpha * (0.5 + 0.5 * sin(t * 2.0 + k))))


# ---------------------------------------------------------------- screenshots
func _parse_args() -> void:
	var args := OS.get_cmdline_user_args()
	for a in args:
		if a.begins_with("--shots="):
			shot_dir = a.substr(8)
		if a == "--cover-only":
			shot_skip = true
		if a == "--autoplay":
			autoplay = true
			_start_play()
	if shot_dir != "" and shot_skip:
		shot_plan = [{"at": 1.0, "do": "cover"}, {"at": 4.5, "name": "07_cover"}, {"at": 5.0, "do": "quit"}]
	elif shot_dir != "":
		# scripted tour for the itch.io page screenshots
		shot_plan = [
			{"at": 1.5, "name": "01_title"},
			{"at": 3.0, "do": "play_scene1"},
			{"at": 6.0, "name": "02_gather"},
			{"at": 6.5, "do": "scene_mist"},
			{"at": 10.0, "name": "03_cold"},
			{"at": 10.5, "do": "scene_lantern"},
			{"at": 16.0, "name": "04_lantern"},
			{"at": 16.5, "do": "scene_wind"},
			{"at": 20.0, "name": "05_wind"},
			{"at": 20.5, "do": "scene_ending"},
			{"at": 38.0, "name": "06_rise"},
			{"at": 38.5, "do": "cover"},
			{"at": 42.0, "name": "07_cover"},
			{"at": 42.5, "do": "quit"},
		]


var _shot_clock := 0.0
func _shots(delta: float) -> void:
	if shot_dir == "" or shot_plan.is_empty():
		return
	_shot_clock += delta
	var s: Dictionary = shot_plan[0]
	if _shot_clock < s.at:
		return
	shot_plan.pop_front()
	if s.has("name"):
		var img := get_viewport().get_texture().get_image()
		img.save_png(shot_dir.path_join(s.name + ".png"))
		return
	match s.do:
		"play_scene1":
			_start_play(); hint_queue.clear(); shown["move"] = true
			for i in 2:
				_join(wisps[i])
			p_pos = Vector2(-60, -560); force_hum = true
			cam.position = p_pos; _line_up()
			hint_queue = ["Hold SPACE (or right-click) to hum to it."]
		"scene_mist":
			for i in 7:
				if wisps[i].state == 0: _join(wisps[i])
			beacons[0].lit = true; beacons[0].glow = 1.0; lit_count = 1; warm_target = 0.22; world_warm = 0.22
			force_hum = false; p_pos = Vector2(760, -2150); cam.position = p_pos; trail.clear(); _line_up()
			hint_queue = ["The cold drains your light. Friends keep you warm."]
		"scene_lantern":
			beacons[1].lit = true; beacons[1].glow = 1.0
			p_pos = Vector2(-170, -2400); cam.position = Vector2(-60, -2470); trail.clear(); _line_up()
			lit_count = 2; world_warm = 0.44; warm_target = 0.44
			bursts.append({"pos": beacons[1].pos + Vector2(0, -80), "t": 0.6, "col": Color(1.0, 0.75, 0.45), "size": 700.0})
			hint_queue = ["Warmth spreads. Higher still."]
		"scene_wind":
			for i in 11:
				if wisps[i].state == 0: _join(wisps[i])
			p_pos = Vector2(200, -3200); cam.position = p_pos; trail.clear(); _line_up()
			hint_queue = ["Ride the wind. Hum to hold steady."]
		"scene_ending":
			for w in wisps:
				if w.state == 0: _join(w)
			for i in 4:
				beacons[i].lit = true; beacons[i].glow = 1.0
			lit_count = 4
			p_pos = Vector2(0, -5900); cam.position = p_pos; trail.clear(); world_warm = 1.2
			_start_ending(); ending_t = 30.0; started_theme = true
			hint_queue.clear(); hint_dur = 0.0
		"cover":
			mode = CREDITS
			credits_t = -1000.0
			theme_player.stop()
			for b in beacons:
				b.lit = true; b.glow = 1.0
			p_pos = Vector2(-200, -4700); cam.zoom = Vector2.ONE; cam.position = p_pos + Vector2(0, -170)
			world_warm = 0.8; warm_target = 0.8; trail.clear(); sparkles.clear()
			for w in wisps:
				w.state = 2; w.pos = p_pos + Vector2(randf_range(-300, 300), randf_range(-150, 150))
			title_box.visible = true; title_box.modulate.a = 1.0; title_press.visible = false
		"quit":
			get_tree().quit()


func _line_up() -> void:
	for i in chain.size():
		chain[i].pos = p_pos + Vector2(-28.0 - 23.0 * i, 10.0 + 6.0 * sin(i))
		chain[i].vel = Vector2.ZERO


# ---------------------------------------------------------------- autoplay test bot
func _bot() -> Vector2:
	var target := p_pos + Vector2(0, -400)
	var hum := false
	if mode == PLAY and lit_count < beacons.size():
		var b: Dictionary = beacons[lit_count]
		target = b.pos + Vector2(0, 60)
		if chain.size() < b.need:
			var best_d := INF
			for w in wisps:
				if w.state == 0 and w.home.y > b.pos.y - 100.0:
					var d: float = p_pos.distance_to(w.pos)
					if d < best_d:
						best_d = d; target = w.pos
		hum = p_pos.distance_to(target) < 170.0
		for w in wisps:
			if w.state == 0 and w.shy and w.pos == target and p_pos.distance_to(target) < 380.0:
				hum = true
	force_hum = hum
	bot_log_t += get_process_delta_time()
	if bot_log_t > 5.0:
		bot_log_t = 0.0
		print("t=%.0f mode=%d pos=%s chain=%d lit=%d warmth=%.2f end=%.0f target=%s" % [t, mode, str(p_pos.round()), chain.size(), lit_count, warmth, ending_t, str(target.round())])
		if t > 400.0:
			for w in wisps:
				if w.state == 0: print("   lost ", w.pos.round(), " home ", w.home.round(), " shy ", w.shy, " listen ", w.listen)
	if mode == CREDITS:
		print("CREDITS reached at t=%.0f" % t)
		get_tree().quit()
	var to := target - p_pos
	return to.normalized() * clamp(to.length() / 100.0, 0.25, 1.0)
